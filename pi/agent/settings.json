{
  "lastChangelogVersion": "1.5.0",
  "theme": "catppuccin-latte-custom",
  "defaultProvider": "codex",
  "defaultModel": "sonnet-5.5",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "codex/gpt-6-astra": "low",
    "codex/gpt-6.1-sol": "medium",
    "claude/opus-5.5": "medium",
    "claude/opus-safe": "medium",
    "claude/sonnet-5.5": "high",
    "claude/sonnet-safe": "high",
    "ds/deepseek-flash": "high",
    "gemini/gemini-3.8-flash": "high",
    "gemini/gemini-4-hydrogen": "high",
    "gemini/gemini-4-argon": "medium",
    "gemini/gemini-4-carbon": "medium",
    "xai/grok-4.6": "high"
  },
  "editorPaddingX": 1,
  "enabledModels": [
    "claude/fable-5.2",
    "claude/opus-5.5",
    "claude/sonnet-5.5",
    "gemini/gemini-4-carbon",
    "gemini/gemini-4-argon",
    "gemini/gemini-4-hydrogen",
    "ds/deepseek-flash",
    "codex/gpt-6.1-sol"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff",
    "git:github.com/sidkang/pi-subagent-manager",
    {
      "source": "git:github.com/sidkang/pi-stuff",
      "extensions": ["!extensions/session-env.ts"],
      "skills": ["!extensions/pi-image-gen/skills/sprite-gen"]
    }
  ],
  "enableInstallTelemetry": false,
  "markdown": {
    "codeBlockIndent": ""
  },
  "terminal": {
    "clearOnShrink": true
  },
  "defaultTools": ["+codemode"],
  "treeFilterMode": "no-tools",
  "steeringMode": "all",
  "transport": "sse",
  "retry": {
    "baseDelayMs": 3000,
    "provider": {
      "maxRetryDelayMs": 30000
    }
  },
  "compaction": {
    "reserveTokens": 16320
  },
  "showHardwareCursor": true,
  "showCacheMissNotices": true,
  "webAccess": {
    "openai": {
      "model": "codex/gpt-6-luna:medium"
    },
    "xai": {
      "model": "xai/grok-4.6:low"
    },
    "merge": {
      "enabled": false,
      "model": "xai/grok-4.6:low"
    },
    "fetch": {
      "extract": {
        "kernel": "firecrawl",
        "model": "xai/grok-4.6:low"
      }
    }
  },
  "codexTools": {
    "fastMode": {
      "eligibleModels": ["gpt-6-astra", "gpt-6.1-sol", "gpt-6-luna"],
      "defaultEnabledModels": []
    },
    "responsesCompaction": {
      "enabled": true,
      "providers": ["codex"]
    }
  },
  "pi-image-gen": {
    "defaultProvider": "pi-codex",
    "defaultModel": "gpt-image-2.6-flare",
    "svgModel": "gpt-6.1-sol",
    "requestTimeoutMs": 300000,
    "openRouterDiscovery": false,
    "spriteGeneration": {
      "enabled": false
    },
    "customProviders": {
      "pi-codex": {
        "api": "openai",
        "piProvider": {
          "provider": "codex",
          "model": "gpt-6.1-sol"
        },
        "models": [
          {
            "id": "gpt-image-2.6-flare",
            "capabilities": {
              "qualityValues": ["low", "medium", "high", "xhigh", "max", "auto"]
            }
          },
          {
            "id": "gpt-image-2.6-sunburst",
            "capabilities": {
              "qualityValues": ["low", "medium", "high", "xhigh", "max", "auto"]
            }
          }
        ]
      }
    }
  },
  "extensionChangelogVersions": {
    "{\"source\":\"git:github.com/sidkang/pi-subagent-manager\",\"scope\":\"user\"}": "1.1.0"
  }
}
