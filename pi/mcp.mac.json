{
  "mcpServers": {
    "openpencil": {
      "command": "/opt/homebrew/bin/mise",
      "args": [
        "exec",
        "--",
        "openpencil-mcp"
      ],
      "exposure": "codemode",
      "description": "OpenPencil desktop document inspection and editing"
    },
    "cua-driver": {
      "command": "ssh",
      "args": [
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "ServerAliveInterval=30",
        "cobalt",
        "C:\\Users\\sid\\AppData\\Local\\Programs\\Cua\\cua-driver\\bin\\cua-driver.exe mcp --socket \\\\.\\pipe\\cua-driver"
      ]
    },
    "safari": {
      "command": "/usr/bin/safaridriver",
      "args": [
        "--mcp"
      ],
      "description": "Safari browser automation and debugging: pages, DOM interactions, screenshots, console and network requests."
    }
  }
}
