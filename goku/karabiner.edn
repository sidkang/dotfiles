{:profiles
 {:goku
  {:default true :sim 50 :delay 180 :alone 150 :held 140}}
 :templates {:kitty-do "/opt/homebrew/bin/kitten @ --to unix:/tmp/kitten %s"
             :kitty-py "export PATH='/opt/homebrew/bin:/usr/bin:$PATH';python3 $HOME/.config/kitty/kitty-action.py %s"
             :om "/opt/homebrew/bin/omniwmctl %s"
             :sh "export PATH='/opt/homebrew/bin:/usr/bin:$PATH';%s"
             :hs "$HOME/.local/bin/hs -q -c 'hsurl(\"%s\")'"
             :hs-notify "$HOME/.local/bin/hs -q -c 'hsurl(\"notify?msg=%s\")'"
             :m1ddc "/opt/homebrew/bin/m1ddc %s"}
 :simlayers {:z-mode {:key :z}
             :f-mode {:key :f}
             :w-mode {:key :w}
             :t-mode {:key :t}}
 :layers {}
 :applications {:chrome ["^com\\.google\\.Chrome$"]
                :logseq ["^com\\.electron\\.logseq$"]
                :terminals ["^com\\.googlecode\\.iterm2$" "^net\\.kovidgoyal\\.kitty$"]
                :kitty ["^net\\.kovidgoyal\\.kitty$"]
                :vscode ["^com\\.microsoft\\.VSCode$"]
                :chatgpt-app ["^com\\.openai\\.chat$"]
                :office ["^com\\.microsoft\\.Word$" "^com\\.microsoft\\.Excel$"]}
 :input-sources {:cn {:language "^zh\\-Hans$" :input_source_id "Shuangpin$"}
                 :en {:language "^en$"}
                 :ja {:language "^ja$"}}
 :main [{:des "ASRF translation"
         :rules [[:left_shift [:sh "open -g asrf://start?mode=translation"] ["fn-mode" 1]]]}
        {:des "Fn as internal layer; Fn alone still sends Fn"
         :rules [[:##fn ["fn-mode" 1] nil {:afterup ["fn-mode" 0] :alone :fn}]

                 :fn-mode
                 [:f1 :display_brightness_decrement]
                 [:f2 :display_brightness_increment]
                 [:f7 :rewind]
                 [:f8 :play_or_pause]
                 [:f9 :fast_forward]
                 [:f10 :mute]
                 [:f11 :volume_decrement]
                 [:f12 :volume_increment]]}
        {:des "input methods: cn us jp"
         :rules [[:##right_command :##right_command :!cn {:alone [:hs "switchIME?to=cn"]}]
                 [:##right_option :##right_option :!ja {:alone [:hs "switchIME?to=ja"]}]
                 [:##left_command :##left_command nil {:alone {:input :en}}]]}
        {:des "KeyCode Swap: :-; \"-'"
         :rules [[:semicolon :!Ssemicolon]
                 [:!Ssemicolon :semicolon]
                 [:!Squote :quote]
                 [:quote
                  [["wm-mode" 1] [:hs "whichkey?action=show&group=wm-mode"]]
                  nil
                  {:afterup [["wm-mode" 0] [:hs "whichkey?action=hide&group=wm-mode"]] :alone :!Squote}]]}

        {:des "wm quote"
         :rules [[:escape [:hs "wm?action=app-toggle&app=obsidian"] ["escape-mode" 1]]
                 [:escape
                  ["escape-mode" 1]
                  nil
                  {:delayed {:invoked [[:hs "wm?action=kitty-hotkey"] ["escape-mode" 0]]
                             :canceled ["escape-mode" 0]}}]

                 [:f1 [:om "command focus previous"]]

                 [:f2 [:om "command toggle-native-fullscreen"] ["f2-mode" 1]]
                 [:f2 ["f2-mode" 1] nil {:delayed {:invoked [[:om "command toggle-fullscreen"] ["f2-mode" 0]] :canceled ["f2-mode" 0]}}]

                 [:f3 [:sh "omniwmctl command move-to-monitor right || omniwmctl command move-to-monitor left"]]
                 [:f4 [:om "command focus-monitor next"]]

                 :wm-mode
                 [:r [["wm-send-ws" 1] [:hs "whichkey?action=show&group=wm-send-ws"]]]
                 [:t [["wm-toggle" 1] [:hs "whichkey?action=show&group=wm-toggle"]]]
                 [:f [["wm-open" 1] [:hs "whichkey?action=show&group=wm-open"]]]
                 [:g [["wm-go" 1] [:hs "whichkey?action=show&group=wm-go"]]]
                 [:s [["wm-swap" 1] [:hs "whichkey?action=show&group=wm-swap"]]]
                 [:z [["z-mode" 1] [:hs "whichkey?action=show&group=z-mode"]]]

                 [:v [:om "command close-focused-window"]]

                 [:h [:om "command focus left"]]
                 [:j [:om "command focus down"]]
                 [:k [:om "command focus up"]]
                 [:l [:om "command focus right"]]

                 [:!Th [:om "command move left"]]
                 [:!Tj [:om "command move down"]]
                 [:!Tk [:om "command move up"]]
                 [:!Tl [:om "command move right"]]

                 [:!Sh [:om "command move-column left"]]
                 [:!Sj [:sh "omniwmctl command move-column down || omniwmctl command move-window-down"]]
                 [:!Sk [:sh "omniwmctl command move-column up || omniwmctl command move-window-up"]]
                 [:!Sl [:om "command move-column right"]]

                 [:1 [:om "command switch-workspace 1"]]
                 [:2 [:om "command switch-workspace 2"]]
                 [:3 [:om "command switch-workspace 3"]]
                 [:4 [:om "command switch-workspace 4"]]
                 [:5 [:om "command switch-workspace 5"]]
                 [:6 [:om "command switch-workspace 6"]]

                 ;; BEGIN menus:wm (generated from menus.toml)
                 :wm-send-ws
                 [:caps_lock [["wm-send-ws" 0] [:hs "whichkey?action=hide&group=wm-send-ws"]]]
                 [:1 [["wm-send-ws" 0] [:om "command move-to-workspace 1"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:2 [["wm-send-ws" 0] [:om "command move-to-workspace 2"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:3 [["wm-send-ws" 0] [:om "command move-to-workspace 3"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:4 [["wm-send-ws" 0] [:om "command move-to-workspace 4"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:5 [["wm-send-ws" 0] [:om "command move-to-workspace 5"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:6 [["wm-send-ws" 0] [:om "command move-to-workspace 6"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:q [["wm-send-ws" 0] [:om "command move-to-workspace 7"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:w [["wm-send-ws" 0] [:om "command move-to-workspace 8"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:e [["wm-send-ws" 0] [:om "command move-to-workspace 9"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:a [["wm-send-ws" 0] [:om "command move-to-workspace 10"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:s [["wm-send-ws" 0] [:om "command move-to-workspace 11"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:d [["wm-send-ws" 0] [:om "command move-to-workspace 12"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]
                 [:t [["wm-send-ws" 0] [:om "command move-to-workspace 13"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-send-ws"]}]

                 :wm-toggle
                 [:caps_lock [["wm-toggle" 0] [:hs "whichkey?action=hide&group=wm-toggle"]]]
                 [:j [["wm-toggle" 0] [:om "command toggle-column-tabbed"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-toggle"]}]
                 [:k [["wm-toggle" 0] [:om "command toggle-split"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-toggle"]}]
                 [:f [["wm-toggle" 0] [:om "command toggle-focused-window-floating"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-toggle"]}]
                 [:e [["wm-toggle" 0] [:sh "killall OmniWM;open -a OmniWM"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-toggle"]}]
                 [:b [["wm-toggle" 0] [:om "command balance-sizes"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-toggle"]}]
                 [:l [["wm-toggle" 0] [:om "command toggle-workspace-layout"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-toggle"]}]
                 [:c [["wm-toggle" 0] [:hs "floatwindow?action=move&target=center"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-toggle"]}]

                 :wm-open
                 [:caps_lock [["wm-open" 0] [:hs "whichkey?action=hide&group=wm-open"]]]
                 [:f [["wm-open" 0] [:sh "osascript -e 'tell application \"Finder\" to make new Finder window'"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-open"]}]
                 [:w [["wm-open" 0] [:hs "wm?action=app-toggle&app=wechat"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-open"]}]
                 [:t [["wm-open" 0] [:hs "wm?action=app-toggle&app=telegram"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-open"]}]
                 [:g [["wm-open" 0] [:hs "wm?action=app-toggle&app=chrome"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-open"]}]

                 :wm-go
                 [:caps_lock [["wm-go" 0] [:hs "whichkey?action=hide&group=wm-go"]]]
                 [:1 [["wm-go" 0] [:om "command switch-workspace 1"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:2 [["wm-go" 0] [:om "command switch-workspace 2"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:3 [["wm-go" 0] [:om "command switch-workspace 3"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:4 [["wm-go" 0] [:om "command switch-workspace 4"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:5 [["wm-go" 0] [:om "command switch-workspace 5"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:6 [["wm-go" 0] [:om "command switch-workspace 6"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:q [["wm-go" 0] [:om "command switch-workspace 7"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:w [["wm-go" 0] [:om "command switch-workspace 8"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:e [["wm-go" 0] [:om "command switch-workspace 9"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:a [["wm-go" 0] [:om "command switch-workspace 10"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:s [["wm-go" 0] [:om "command switch-workspace 11"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:d [["wm-go" 0] [:om "command switch-workspace 12"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]
                 [:t [["wm-go" 0] [:om "command switch-workspace 13"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-go"]}]

                 :wm-swap
                 [:caps_lock [["wm-swap" 0] [:hs "whichkey?action=hide&group=wm-swap"]]]
                 [:h [["wm-swap" 0] [:om "command move-column left"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-swap"]}]
                 [:j [["wm-swap" 0] [:sh "omniwmctl command move-column down || omniwmctl command move-window-down"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-swap"]}]
                 [:k [["wm-swap" 0] [:sh "omniwmctl command move-column up || omniwmctl command move-window-up"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-swap"]}]
                 [:l [["wm-swap" 0] [:om "command move-column right"]] nil {:afterup [:hs "whichkey?action=hide&group=wm-swap"]}]
                 ;; END menus:wm
                 ]}
        {:des "wm []"
         :rules [[:open_bracket ["bracket-l-mode" 1] nil {:afterup ["bracket-l-mode" 0] :alone :open_bracket}]
                 [:close_bracket ["bracket-r-mode" 1] nil {:afterup ["bracket-r-mode" 0] :alone :close_bracket}]

                 :bracket-l-mode
                 [:a [:hs "wm?action=cycle-app&dir=prev"]]
                 [:w [:om "command move-to-workspace up"]]
                 [:s [:om "command switch-workspace prev"]]
                 [:h [:hs "wm?action=resize&axis=h&delta=-50"]]
                 [:v [:hs "wm?action=resize&axis=v&delta=-50"]]
                 [:d :delete_or_backspace]
                 [:m [:sh "omniwmctl command move-to-monitor left || omniwmctl command move-to-monitor right"]]

                 :bracket-r-mode
                 [:a [:hs "wm?action=cycle-app&dir=next"]]
                 [:w [:om "command move-to-workspace down"]]
                 [:s [:om "command switch-workspace next"]]
                 [:h [:hs "wm?action=resize&axis=h&delta=50"]]
                 [:v [:hs "wm?action=resize&axis=v&delta=50"]]
                 [:d :delete_forward]
                 [:m [:sh "omniwmctl command move-to-monitor right || omniwmctl command move-to-monitor left"]]]}
        {:des "common ,./"
         :rules [[:slash ["app-mode" 1] :!z-mode {:afterup ["app-mode" 0] :alone :slash}]

                 [:condi :chrome :app-mode]
                 [:1 [:!C1]]
                 [:2 [:!C2]]
                 [:3 [:!C3]]
                 [:4 [:!C4]]
                 [:5 [:!C5]]
                 [:6 [:!C6]]
                 [:r :!Cr]
                 [:!Sr :!CSr]
                 [:c :!SCt]
                 [:x :!Cw]
                 [:t :!Ct]
                 [:a :!CSa]
                 [:comma :!CSopen_bracket]
                 [:period :!CSclose_bracket]

                 [:condi :kitty :app-mode]
                 [:1 [:kitty-do "focus-tab --match index:0"]]
                 [:2 [:kitty-do "focus-tab --match index:1"]]
                 [:3 [:kitty-do "focus-tab --match index:2"]]
                 [:4 [:kitty-do "focus-tab --match index:3"]]
                 [:5 [:kitty-do "focus-tab --match index:4"]]
                 [:6 [:kitty-do "focus-tab --match index:5"]]
                 [:7 [:kitty-do "focus-tab --match index:6"]]
                 [:8 [:kitty-do "focus-tab --match index:7"]]
                 [:comma  [:kitty-do "action previous_tab"]]
                 [:period [:kitty-do "action next_tab"]]
                 [:up_arrow [:kitty-do "action -m state:focused scroll_to_prompt -1"]]
                 [:down_arrow [:kitty-do "action -m state:focused scroll_to_prompt 1"]]
                 [:p [:kitty-do "action -m state:focused command_palette"]]
                 [:v [:kitty-do "launch --match state:focused --type window --location vsplit --cwd=current"]]
                 [:s [:kitty-do "launch --match state:focused --type window --location hsplit --cwd=current"]]
                 [:t [:kitty-do "launch --match state:focused --type tab --cwd=current"]]
                 [:f [:kitty-do "action -m state:focused focus_visible_window"]]
                 [:!St [:kitty-do "action -m state:focused set_tab_title"]]
                 [:g [:kitty-do "action -m state:focused swap_with_window"]]
                 [:h [:kitty-do "focus-window --match state:focused --match neighbor:left"]]
                 [:j [:kitty-do "focus-window --match state:focused --match neighbor:bottom"]]
                 [:k [:kitty-do "focus-window --match state:focused --match neighbor:top"]]
                 [:l [:kitty-do "focus-window --match state:focused --match neighbor:right"]]
                 [:!Sh [:kitty-do "action -m state:focused move_window left"]]
                 [:!Sj [:kitty-do "action -m state:focused move_window down"]]
                 [:!Sk [:kitty-do "action -m state:focused move_window up"]]
                 [:!Sl [:kitty-do "action -m state:focused move_window right"]]
                 [:!Oh [:kitty-do "resize-window --match state:focused --axis horizontal --increment -5"]]
                 [:!Oj [:kitty-do "resize-window --match state:focused --axis vertical --increment 5"]]
                 [:!Ok [:kitty-do "resize-window --match state:focused --axis vertical --increment -5"]]
                 [:!Ol [:kitty-do "resize-window --match state:focused --axis horizontal --increment 5"]]
                 [:r [:kitty-do "action -m state:focused layout_action rotate"]]
                 [:equal_sign [:kitty-do "action -m state:focused layout_action equalize"]]
                 [:!Sr [:kitty-do "action -m state:focused next_layout"]]
                 [:m [:kitty-py "toggle worker"]]
                 [:x [:kitty-do "close-window --match state:focused"]]
                 [:z [:kitty-do "action -m state:focused toggle_layout stack"]]

                 [:condi :chatgpt-app :app-mode]
                 [:1 [:!C1]]
                 [:2 [:!C2]]
                 [:3 [:!C3]]
                 [:4 [:!C4]]
                 [:5 [:!C5]]
                 [:6 [:!C6]]

                 [:condi :office :app-mode]
                 [:h :!CSh]

                 :caps-mode
                 [:return_or_enter :!CTreturn_or_enter :caps-mode]

                 :logseq
                 [:!Ck [:!Ck {:input :en}]]
                 [:y :return_or_enter ["caps-mode" 1]]

                 [:condi]
                 [:x :!Cw :app-mode]]}
        {:des "Mouse mode"
         :rules [:f-mode
                 [:n {:pkey :button1}]
                 [:m [["mouse-mode" 1] [:noti :mmode "Hit caps_lock to quit Mouse Mode"]]]
                 :mouse-mode
                 [:caps_lock [["mouse-mode" 0] [:noti :mmode]]]
                 [:h {:mkey {:x -3000}}]
                 [:j {:mkey {:y 3000}}]
                 [:k {:mkey {:y -3000}}]
                 [:l {:mkey {:x 3000}}]
                 [:!Sh {:mkey {:x -1000}}]
                 [:!Sj {:mkey {:y 1000}}]
                 [:!Sk {:mkey {:y -1000}}]
                 [:!Sl {:mkey {:x 1000}}]
                 [:##n {:pkey :button1}]
                 [:##m {:pkey :button2}]]}

        {:des "mouse mode f + hjkl as arrow keys"
         :rules [:f-mode
                 [:h :left_arrow]
                 [:j :down_arrow]
                 [:k :up_arrow]
                 [:l :right_arrow]
                 [:u :page_up]
                 [:i :home]
                 [:o :end]
                 [:p :page_down]]}

        {:des "window & tab"
         :rules [:w-mode
                 [:q :!Cw]
                 [:h :!CSgrave_accent_and_tilde]
                 [:l :!Cgrave_accent_and_tilde]
                 :t-mode
                 [:n :!Ct]
                 [:q :!Cw]
                 [:h :!CSopen_bracket]
                 [:l :!CSclose_bracket]]}

        {:des "z mode"
         :rules [:z-mode
                 [:caps_lock [["z-mode" 0] [:hs "whichkey?action=hide"]]]
                 [:1 [:m1ddc "set input 16"]]
                 [:2 [:m1ddc "set input 15"]]
                 [:3 [:m1ddc "set input 17"]]

                 [:q [["m1ddc-pbp" 1] [:hs "whichkey?action=show&group=m1ddc-pbp"]]]
                 ;; BEGIN menus:z (generated from menus.toml)
                 :m1ddc-pbp
                 [:caps_lock [["m1ddc-pbp" 0] [:hs "whichkey?action=hide"]]]
                 [:1 [["m1ddc-pbp" 0] [:m1ddc "set input 16"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:2 [["m1ddc-pbp" 0] [:m1ddc "set input 15"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:3 [["m1ddc-pbp" 0] [:m1ddc "set input 17"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:q [["m1ddc-pbp" 0] [:m1ddc "set pbp-input 16"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:w [["m1ddc-pbp" 0] [:m1ddc "set pbp-input 15"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:e [["m1ddc-pbp" 0] [:m1ddc "set pbp-input 17"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:a [["m1ddc-pbp" 0] [:m1ddc "set pbp 0"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:s [["m1ddc-pbp" 0] [:m1ddc "set pbp 33"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:d [["m1ddc-pbp" 0] [:m1ddc "set pbp 34"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 [:f [["m1ddc-pbp" 0] [:m1ddc "set pbp 36"]] nil {:afterup [:hs "whichkey?action=hide"]}]
                 ;; END menus:z

                 :z-mode
                 [:o [:hs "callBob?action=selectionTranslate"]]
                 [:p [:hs "callBob?action=snipTranslate"]]
                 [:9 [:hs "openConsole"]]
                 [:0 [:hs "reloadConfig"]]

                 [:equal_sign [:hs-notify "-1&level=error"]]
                 [:slash [:hs "scpt?name=xnip_capture"]]]}

        {:des "caps-mode"
         :rules [[:caps_lock :left_control :terminals {:alone :escape}]
                 [:caps_lock :left_control :vscode {:alone :escape}]
                 [:caps_lock ["caps-mode" 1] nil {:afterup ["caps-mode" 0] :alone :escape}]]}]}
